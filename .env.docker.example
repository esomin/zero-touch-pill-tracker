# [백엔드 설정]
# MongoDB Atlas 연결 시: mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
# 로컬 MongoDB 연결 시: mongodb://admin:password@mongodb:27017/med_tracker?authSource=admin
MONGO_URI=mongodb+srv://admin:password@prod-cluster.bat4mdb.mongodb.net/?appName=prod-cluster
DB_NAME=med_tracker
BACKEND_PORT=8000

# [프론트엔드 빌드 설정]
# 프론트엔드가 접속할 백엔드 API & WebSocket URL
# 클라우드 VM (GCP Compute Engine / AWS EC2) 배포 시:
# 예시) VITE_API_URL=http://34.64.123.45:8000
VITE_API_URL=http://<서버_공인_IP>:8000
VITE_WS_URL=ws://<서버_공인_IP>:8000
FRONTEND_PORT=80
